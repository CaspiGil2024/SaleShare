VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# EmailJS (https://www.emailjs.com/) — booking confirmation + shared-sail
# notification emails, sent directly from the browser. All four values
# come from your EmailJS dashboard; none of them are secret the way a
# service-role key is (EmailJS's public key is meant to be used
# client-side). Leave these unset and email sending simply no-ops.
VITE_EMAILJS_SERVICE_ID=your-emailjs-service-id
VITE_EMAILJS_PUBLIC_KEY=your-emailjs-public-key
# Template for the organizer's own booking confirmation. Must define
# these merge tags: to_email, to_name, booking_type_label,
# start_time_he, end_time_he, duration_hours, google_calendar_link
VITE_EMAILJS_TEMPLATE_BOOKING_CONFIRMATION=your-confirmation-template-id
# Template for shared-sail notifications (to added participants, and to
# any other partner who opted into "receive shared sail updates"). Must
# define: to_email, to_name, organizer_name, booking_type_label,
# start_time_he, end_time_he, google_calendar_link
VITE_EMAILJS_TEMPLATE_SHARED_SAIL_NOTIFICATION=your-notification-template-id
# Template for shared-sail CANCELLATION notifications (same opted-in
# audience as above). Must define: to_email, to_name, organizer_name,
# booking_type_label, start_time_he, end_time_he — no
# google_calendar_link here, there's nothing left to add to a calendar.
VITE_EMAILJS_TEMPLATE_CANCEL_SHARED_SAIL=your-cancel-notification-template-id
