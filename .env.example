VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# EmailJS (https://www.emailjs.com/) — booking confirmation, shared-sail,
# and maintenance-resolution notification emails, sent directly from the
# browser. All values come from your EmailJS dashboard; none of them are
# secret the way a service-role key is (EmailJS's public key is meant to
# be used client-side). Leave these unset and email sending simply no-ops.
#
# ⚠️ For EACH template below, the dashboard's "To Email" field MUST be set
# to {{to_email}} (the app also fills {{email}} and {{recipient}} with the
# same value, so any of those works). If it is left blank, hardcoded to an
# address, or points at a tag the app doesn't send, EmailJS delivers every
# message to the connected account's own address — that is what "all
# notifications go to one inbox" looks like. The app never hardcodes a
# recipient; it always passes the real per-partner address.
VITE_EMAILJS_SERVICE_ID=your-emailjs-service-id
VITE_EMAILJS_PUBLIC_KEY=your-emailjs-public-key
# Template for the organizer's own booking confirmation. Must define
# these merge tags: to_email, to_name, booking_type_label,
# start_time_he, end_time_he, duration_hours, google_calendar_link
VITE_EMAILJS_TEMPLATE_BOOKING_CONFIRMATION=your-confirmation-template-id
# Template for shared-sail notifications (broadcast to every other
# active partner with emails_enabled). Must define: to_email, to_name,
# organizer_name, booking_type_label, start_time_he, end_time_he,
# google_calendar_link
VITE_EMAILJS_TEMPLATE_SHARED_SAIL_NOTIFICATION=your-notification-template-id
# Template for shared-sail CANCELLATION notifications (same opted-in
# audience as above). Must define: to_email, to_name, organizer_name,
# booking_type_label, start_time_he, end_time_he — no
# google_calendar_link here, there's nothing left to add to a calendar.
VITE_EMAILJS_TEMPLATE_CANCEL_SHARED_SAIL=your-cancel-notification-template-id
# Template for critical maintenance/grounding RESOLUTION notices — sent
# to every partner with emails_enabled AND receive_critical_updates on,
# when a maintenance issue flagged is_grounding (השבתת יאכטה) is marked
# resolved. Must define: to_email, to_name, status_message, summary,
# resolution_notes
VITE_EMAILJS_TEMPLATE_MAINTENANCE_RESOLVED=your-maintenance-resolved-template-id
# Template for the vessel-grounding ALERT (opposite end of the
# resolution notice above) — sent to the same emails_enabled +
# receive_critical_updates audience the moment a new maintenance issue
# is reported with is_grounding checked. Must define: to_email, to_name,
# status_message, summary, description
VITE_EMAILJS_TEMPLATE_VESSEL_GROUNDING=your-vessel-grounding-template-id
