# Config for tests/sharedSailCoinEngine.test.js — a real integration
# test against the shared-sail coin engine's Postgres RPCs. These MUST
# point at a LOCAL Supabase stack, never the production project: the
# tests create real auth users, book real Shared sailings, and rewrite
# bookings.start_time directly to force settlement — none of that
# should ever touch real partner data.
#
# Setup:
#   1. Install the Supabase CLI, then from the repo root: `supabase init`
#      (first time only) and `supabase start`. This spins up a full
#      local Postgres + Auth + REST stack in Docker and applies every
#      migration in supabase/migrations/.
#   2. `supabase start`'s own output prints the API URL and both keys
#      below — copy them into a real `.env.test.local` (gitignored,
#      same convention as `.env.local`).
#   3. Run the tests: `npm test`.

SUPABASE_TEST_URL=http://127.0.0.1:54321
SUPABASE_TEST_ANON_KEY=your-local-anon-key-from-supabase-start
SUPABASE_TEST_SERVICE_ROLE_KEY=your-local-service-role-key-from-supabase-start
